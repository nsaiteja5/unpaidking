# Database (MySQL / Aiven / PlanetScale / RDS)
DATABASE_URL=mysql://user:password@host:port/defaultdb?ssl-mode=REQUIRED

# Admin Panel Password
ADMIN_PASSWORD=your-secure-admin-password

# Base URL (e.g. https://unpaidking.lol)
NEXT_PUBLIC_BASE_URL=https://unpaidking.lol

# Payments
STUB_PAYMENTS=true
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# X (Twitter) OAuth 2.0
X_CLIENT_ID=your-x-client-id
X_CLIENT_SECRET=your-x-client-secret

# Session Secret (32+ characters)
SESSION_SECRET=change-me-to-a-random-secret-key-32chars

# Stub X Auth for local testing
STUB_X_AUTH=false
